      "prettier --write"
    ],
    "*.{json,md,html,css}": "prettier --write"
  },
  "type": "module",
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.56.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "lint-staged": "16.1.6",
    "prettier": "3.2.5",
    "ts-jest": "29.2.5",
    "typescript": "5.5.4"
  }
}
