{
  "name": "country-search",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --ext .ts,.cjs",
    "format": "prettier --check .",
    "test": "jest --passWithNoTests",
    "prepare": "husky"
  },
  "lint-staged": {
